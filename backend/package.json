{
  "name": "ts-backend-production-template",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node --enable-source-maps dist/src/server.js",
    "dev": "nodemon",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "format:check": "prettier . --check",
    "format:fix": "prettier . --write",
    "migrate:dev": "cross-env MIGRATE_MODE=development npx migrate up -a true",
    "migrate:local": "cross-env MIGRATE_MODE=development npx migrate up -d mongodb://localhost:27017/sc-tracker -a true",
    "migrate:prod": "cross-env MIGRATE_MODE=production npx migrate up",
    "stride:sync": "npx tsc --sourceMap && node --enable-source-maps --env-file=.env.development dist/script/stride/sync-all.js",
    "stride:sync:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/stride/sync-all.js",
    "stride:sync:countries": "npx tsc --sourceMap && node --enable-source-maps --env-file=.env.development dist/script/stride/sync-countries.js",
    "stride:sync:countries:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/stride/sync-countries.js",
    "stride:seed:country-999:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/stride/seed-country-999.js",
    "stride:sync:laws:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/stride/run-sync-laws.js",
    "stride:sync:issuers": "npx tsc --sourceMap && node --enable-source-maps --env-file=.env.development dist/script/stride/sync-issuers.js",
    "stride:sync:issuers:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/stride/sync-issuers.js",
    "stride:sync:stablecoins": "npx tsc --sourceMap && node --enable-source-maps --env-file=.env.development dist/script/stride/sync-stablecoins.js",
    "stride:sync:stablecoins:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/stride/sync-stablecoins.js",
    "stride:sync:licenses": "npx tsc --sourceMap && node --enable-source-maps --env-file=.env.development dist/script/stride/sync-licenses.js",
    "stride:sync:licenses:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/stride/sync-licenses.js",
    "allium:sync:wallets": "npx tsc --sourceMap && node --enable-source-maps --env-file=.env.development dist/script/allium/sync-wallets.js",
    "allium:sync:wallets:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/allium/sync-wallets.js",
    "allium:sync:corridors": "npx tsc --sourceMap && node --enable-source-maps --env-file=.env.development dist/script/allium/sync-corridors.js",
    "allium:sync:corridors:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/allium/sync-corridors.js",
    "population:sync": "npx tsc --sourceMap && node --enable-source-maps --env-file=.env.development dist/script/general/sync-population.js",
    "population:sync:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/general/sync-population.js",
    "gdp:sync": "npx tsc --sourceMap && node --enable-source-maps --env-file=.env.development dist/script/general/sync-gdp.js",
    "gdp:sync:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/general/sync-gdp.js",
    "remittances:sync": "npx tsc --sourceMap && node --enable-source-maps --env-file=.env.development dist/script/general/sync-remittances.js",
    "remittances:sync:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/general/sync-remittances.js",
    "services:sync": "npx tsc --sourceMap && node --enable-source-maps --env-file=.env.development dist/script/general/sync-services.js",
    "services:sync:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/general/sync-services.js",
    "exchange-rates:sync": "npx tsc --sourceMap && node --enable-source-maps --env-file=.env.development dist/script/general/sync-exchange-rates.js",
    "exchange-rates:sync:local": "npx tsc --sourceMap && cross-env DB_URL=mongodb://localhost:27017/sc-tracker node --enable-source-maps --env-file=.env.development dist/script/general/sync-exchange-rates.js",
    "live-sources:snapshot": "npx tsc --sourceMap && node --enable-source-maps dist/script/general/snapshot-live-sources.js",
    "db:seed": "npm run migrate:dev && npm run population:sync && npm run allium:sync:wallets",
    "db:seed:local": "npm run migrate:local && npm run population:sync:local && npm run allium:sync:wallets:local",
    "db:seed:full": "npm run db:seed && npm run stride:sync && npm run remittances:sync && npm run services:sync && npm run gdp:sync",
    "db:seed:full:local": "npm run db:seed:local && npm run stride:sync:local && npm run remittances:sync:local && npm run services:sync:local && npm run gdp:sync:local"
  },
  "author": "EY",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.32.0",
    "@tsconfig/node22": "^22.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.7",
    "cross-env": "^10.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "nodemon": "^3.1.9",
    "prettier": "3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "colorette": "^2.0.20",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.1",
    "mongoose": "^8.17.1",
    "rate-limiter-flexible": "^7.2.0",
    "swagger-ui-express": "^5.0.1",
    "ts-migrate-mongoose": "^4.0.9",
    "winston": "^3.17.0",
    "winston-mongodb": "^7.0.0",
    "zod": "^4.4.3"
  }
}
